{
  "files.exclude": {
    "**/node_modules": true,
    "**/.quartz-cache": true,
    "**/public": true
  },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": false,
  "autoSnippet.snippets": [
    {
      "regex": "[\\\\/]content[\\\\/](?!(?:templates|private|\\.obsidian|\\.trash)[\\\\/])(?!.*[\\\\/](?:templates|private|\\.obsidian|\\.trash)[\\\\/]).*\\.md$",
      "snippet": "J4sper new note",
      "commands": ["workbench.action.files.save"]
    }
  ]
}
