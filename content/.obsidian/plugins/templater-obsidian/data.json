{
  "data_version": 2,
  "command_timeout": 5,
  "templates_folder": "templates",
  "templates_pairs": [],
  "trigger_on_file_creation_mode": "regex",
  "auto_jump_to_cursor": false,
  "jump_to_cursor_after_file_name": false,
  "shell_path": "",
  "user_scripts_folder": "",
  "folder_templates": [],
  "file_templates": [
    {
      "regex": "^(?!(?:templates|private|\\.obsidian|\\.trash)(?:/|$))(?!.*\\/(?:templates|private|\\.obsidian|\\.trash)\\/).*\\.md$",
      "template": "templates/new-note.md"
    }
  ],
  "syntax_highlighting": true,
  "syntax_highlighting_mobile": false,
  "enabled_templates_hotkeys": [],
  "startup_templates": [],
  "intellisense_render": "1",
  "ignore_folders_on_creation": [
    {
      "folder": "templates"
    },
    {
      "folder": "private"
    },
    {
      "folder": ".obsidian"
    },
    {
      "folder": ".trash"
    }
  ]
}